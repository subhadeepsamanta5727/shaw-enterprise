<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to existing files (e.g. uploaded images in /uploads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other API requests through index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>

